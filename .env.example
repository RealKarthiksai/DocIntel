# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doc_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_intelligence

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=doc_intelligence

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8002
CHROMA_PERSIST_DIRECTORY=./data/chromadb

# Security / JWT
JWT_SECRET=super-secret-enterprise-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM & RAG
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage & Uploads
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=25
